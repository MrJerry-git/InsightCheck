RECOMMENDATION_ARTIFACT_PATH=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Reserved for a future LLM adapter. No provider is configured yet.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
