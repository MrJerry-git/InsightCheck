# Backend
APP_NAME=循影定检 API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./xunying.db
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
