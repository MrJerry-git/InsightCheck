# Backend
APP_NAME=循影定检 API
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./xunying.db
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional path to a validated DeepFM artifact directory. If empty, ranking returns HTTP 503.
RECOMMENDATION_ARTIFACT_PATH=

# 鉴权（T01）。生产与联合验收前设为 true；开发默认 false 时按匿名管理员处理。
AUTH_REQUIRED=false
# 会话有效期（分钟）与口令派生迭代次数（留空使用默认 210000）。
SESSION_TTL_MINUTES=720
PASSWORD_HASH_ITERATIONS=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Local smart report import (Ollama; no cloud upload).
IMPORT_MODEL_URL=http://127.0.0.1:11434
IMPORT_MODEL=qwen3-vl:4b-instruct
IMPORT_MODEL_TIMEOUT=240

# Reserved for other future LLM features.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
